# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# QNX Maintainer: Felix Xing <fxing@qnx.com>
pkgname=libxfce4windowing
pkgver=4.20.4
pkgrel=0
pkgdesc="Windowing concept abstraction library for Wayland"
url="https://gitlab.xfce.org/xfce/libxfce4windowing"
arch="all"
license="LGPL-2.1-or-later"
depends="gtk3"
depends="gtk3 libintl"
depends_dev="
    libdisplay-info-dev"
makedepends="
    $depends_dev
    gettext-dev
    glib-dev
    gobject-introspection-dev
    gtk3-dev
    libdisplay-info-dev
    meson
    wayland-dev
    xfce4-dev-tools
    wlr-protocols
    "
subpackages="$pkgname-dev $pkgname-lang"
source="https://gitlab.xfce.org/xfce/libxfce4windowing/-/archive/libxfce4windowing-$pkgver/libxfce4windowing-libxfce4windowing-$pkgver.tar.bz2"
builddir="$srcdir/libxfce4windowing-libxfce4windowing-$pkgver"

build() {
    meson \
        -Dprefix=/usr \
        -Dtests=false \
        output .
    meson compile -C output
}

check() {
    meson test --print-errorlogs -C output
}

package() {
    DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

sha512sums="
